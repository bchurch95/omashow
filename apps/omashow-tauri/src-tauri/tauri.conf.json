{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omashow",
  "version": "0.1.0",
  "identifier": "dev.omashow.app",
  "build": {
    "frontendDist": "../src/frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Omashow",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
